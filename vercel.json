{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "access-control-allow-origin", "value": "*" }]
    }
  ]
}
